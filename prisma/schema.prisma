generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SusAccount {
  userId              String   @id @map("user_id")
  principalStablecoin String   @map("principal_stablecoin")
  susBalance          Decimal  @map("sus_balance")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("sus_accounts")
}

model Allocation {
  id               String   @id
  userId           String   @map("user_id")
  amount           Decimal
  sourceChain      String   @map("source_chain")
  destChain        String   @map("dest_chain")
  inputStablecoin  String   @map("input_stablecoin")
  outputStablecoin String   @map("output_stablecoin")
  status           String
  txHash           String?  @map("tx_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("allocations")
}

model DestinationBalance {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  chainId    String   @map("chain_id")
  stablecoin String
  balance    Decimal
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, chainId, stablecoin])
  @@map("destination_balances")
}
